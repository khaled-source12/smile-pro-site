---
layout: "layouts/landing.njk"
locale: "ar"
permalink: "/ar/laser-eye-surgery-cost-egypt/"
canonical: "/ar/laser-eye-surgery-cost-egypt/"
alternate_url: "/laser-eye-surgery-cost-egypt/"
x_default_url: "/laser-eye-surgery-cost-egypt/"
page_kind: "calculator"
page_css: "calculator-ar.css"
page_js: "calculator-ar.js"
has_form: true
eleventyComputed:
  title: "أسعار عمليات الليزك في مصر ٢٠٢٦ — سمايل برو، فيمتو ليزك وأكتر | Smile Pro Egypt"
  description: "اعرف سعر عملية الليزك في مصر. احسب تكلفة سمايل برو، فيمتو ليزك، PRK و ICL حسب نظرك واحصل على ترشيح علاجي أولي."
image: "/images/Naggar6.webp"
show_sticky: true
sitemap: true
---
{% from "partials/forms.njk" import estimator with context %}
{% from "partials/icons.njk" import whatsappIcon %}
<script type="application/json" id="pricing-data">{{ pricing | json | safe }}</script>
<script type="application/json" id="aftercare-data">{{ clinical.aftercare | json | safe }}</script>
<!-- Google Tag Manager (noscript) -->

<!-- End Google Tag Manager (noscript) -->

<!-- NAV -->


<!-- HERO -->
<section class="hero">
  <div class="container">
    <div class="hero-pill">
      <div class="hero-pill-dot"></div>
      أسعار محدّثة سبتمبر ٢٠٢٦ · أسعار العيادة الفعلية
    </div>
    <h1>عملية الليزك في مصر<br/><em>بكام فعلاً؟</em></h1>
    <p class="hero-sub">جاوب على كام سؤال سريع عن نظرك. هنقولك السعر التقريبي ونقدم ترشيحًا أوليًا لـ سمايل برو، فيمتو ليزك، PRK أو ICL.</p>
  </div>
</section>

<!-- WIZARD -->
<section class="wizard-section" id="wizard">
  <div class="container">
    <div class="wizard-card">

      <!-- Progress -->
      <div class="wizard-progress">
        <div class="wp-step active" id="wp1"><span class="wp-num">١</span>نظرك</div>
        <div class="wp-step" id="wp2"><span class="wp-num">٢</span>عينك</div>
        <div class="wp-step" id="wp3"><span class="wp-num">٣</span>التقدير</div>
      </div>

      <div class="wizard-body">

        <!-- ═══ STEP 1 ═══ -->
        <div class="wiz-step active" id="step1">
          <div class="wiz-q">نظرك ضعيف قد إيه؟</div>
          <div class="wiz-hint">مش متأكد؟ اختار الأقرب — فحص البنتاكام بيحدد الرقم بالظبط.</div>
          <div class="opt-grid">
            <button type="button" class="opt-card" aria-pressed="false" onclick="selectOpt(this,'rx','mild')">
              <span class="opt-icon">👓</span>
              <span><span class="opt-label">خفيف</span><span class="opt-desc">بقدر أمشي من غير نظارة فترات قصيرة</span></span>
            </button>
            <button type="button" class="opt-card" aria-pressed="false" onclick="selectOpt(this,'rx','moderate')">
              <span class="opt-icon">🔍</span>
              <span><span class="opt-label">متوسط</span><span class="opt-desc">محتاج نظارة لأغلب الأنشطة — الوشوش مش واضحة من بعيد</span></span>
            </button>
            <button type="button" class="opt-card" aria-pressed="false" onclick="selectOpt(this,'rx','high')">
              <span class="opt-icon">🌫️</span>
              <span><span class="opt-label">عالي</span><span class="opt-desc">أي حاجة أبعد من إيدي مش واضحة — مستحيل من غير نظارة</span></span>
            </button>
            <button type="button" class="opt-card" aria-pressed="false" onclick="selectOpt(this,'rx','extreme')">
              <span class="opt-icon">➖</span>
              <span><span class="opt-label">عالي جداً</span><span class="opt-desc">حوالي ‎−١٠٫٠٠ أو أقوى، أو دكتور قالي إن الليزر ممكن ما يناسبنيش</span></span>
            </button>
            <button type="button" class="opt-card" aria-pressed="false" onclick="selectOpt(this,'rx','unsure')">
              <span class="opt-icon">🤷</span>
              <span><span class="opt-label">مش متأكد</span><span class="opt-desc">عارف إني محتاج نظارة بس مش عارف القياس</span></span>
            </button>
          </div>
          <div class="wiz-nav">
            <div></div>
            <button type="button" class="wiz-next" id="next1" disabled onclick="goStep(2)">التالي</button>
          </div>
        </div>

        <!-- ═══ STEP 2 ═══ -->
        <div class="wiz-step" id="step2">
          <div class="wiz-q">فيه حاجة تانية عن عينك؟</div>
          <div class="wiz-hint">اختار كل اللي ينطبق عليك — أو كمّل لو مفيش.</div>
          <div class="chk-grid">
            <button type="button" class="chk-card" aria-pressed="false" onclick="toggleChk(this,'thin-cornea')">
              <span class="chk-box"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span><span style="font-weight:600">قرنية رفيعة</span><span style="font-size:12px;color:var(--muted)">دكتور قالي قبل كده</span></span>
            </button>
            <button type="button" class="chk-card" aria-pressed="false" onclick="toggleChk(this,'dry-eyes')">
              <span class="chk-box"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span><span style="font-weight:600">جفاف أو حساسية في العين</span><span style="font-size:12px;color:var(--muted)">عيني بتدمع أو بتحرقني كتير</span></span>
            </button>
            <button type="button" class="chk-card" aria-pressed="false" onclick="toggleChk(this,'active')">
              <span class="chk-box"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span><span style="font-weight:600">رياضة ونشاط بدني</span><span style="font-size:12px;color:var(--muted)">جيم، كورة، سباحة، إلخ</span></span>
            </button>
            <button type="button" class="chk-card" aria-pressed="false" onclick="toggleChk(this,'keratoconus')">
              <span class="chk-box"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span><span style="font-weight:600">قرنية مخروطية / بحك عيني كتير</span><span style="font-size:12px;color:var(--muted)">مشخّص أو مشتبه فيه</span></span>
            </button>
          </div>

          <div style="margin-top:24px">
            <div class="wiz-q" style="font-size:20px">إيه أهم حاجة بالنسبالك؟</div>
            <div class="wiz-hint" id="priority-hint">اختار أولوية واحدة عشان تكمّل.</div>
            <div class="opt-grid">
              <button type="button" class="opt-card" data-priority-option aria-pressed="false" onclick="selectOpt(this,'priority','no-dryeye')" style="padding:13px 18px">
                <span class="opt-icon" style="width:32px;height:32px;font-size:15px">💧</span>
                <span><span class="opt-label" style="font-size:14px">تقليل احتمال جفاف العين</span></span>
              </button>
              <button type="button" class="opt-card" data-priority-option aria-pressed="false" onclick="selectOpt(this,'priority','fast-recovery')" style="padding:13px 18px">
                <span class="opt-icon" style="width:32px;height:32px;font-size:15px">⚡</span>
                <span><span class="opt-label" style="font-size:14px">أسرع تعافي</span></span>
              </button>
              <button type="button" class="opt-card" data-priority-option aria-pressed="false" onclick="selectOpt(this,'priority','lowest-cost')" style="padding:13px 18px">
                <span class="opt-icon" style="width:32px;height:32px;font-size:15px">💰</span>
                <span><span class="opt-label" style="font-size:14px">أقل تكلفة</span></span>
              </button>
            </div>
          </div>

          <div class="wiz-nav">
            <button type="button" class="wiz-back" onclick="goStep(1)">رجوع ←</button>
            <button type="button" class="wiz-next" id="next2" aria-describedby="priority-hint" disabled onclick="goStep(3)">شوف التقدير</button>
          </div>
        </div>

        <!-- ═══ STEP 3 ═══ -->
        <div class="wiz-step" id="step3">
          <div class="result-wrap" id="result-area"></div>

          <div class="gate" id="lead-gate">
            <div class="gate-title">احصل على التفاصيل الكاملة</div>
            <div class="gate-sub">هنبعتلك التقدير على واتساب ونحجزلك فحص البنتاكام.</div>

            {{ estimator('ar') }}

            <p class="form-note">لديك أسئلة قبل الحضور؟ يجيبك فريقنا عنها عبر الهاتف مجاناً.</p>
            <div class="wa-alt">
              <span>تحب تتكلم الأول؟</span>
              <a href="#" id="wa-results-link" class="wa-link" target="_blank" rel="noopener">
                {{ whatsappIcon() }}
                ابعتلي النتيجة على واتساب
              </a>
            </div>
          </div>
          <div class="result-details" id="result-details"></div>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- PRICE TABLE -->
<section class="info-section" style="background:var(--white)">
  <div class="container">
      <span class="lbl">أسعار عمليات الليزك في مصر — ٢٠٢٦</span>
    <div class="rule"></div>
    <h2>كل التقنيات، <em>بأسعار واضحة</em></h2>
    <p style="font-size:15px;color:var(--muted);max-width:560px;margin-top:10px;line-height:2">الأسعار للعينين وشاملة المتابعة. التقنية المناسبة بتعتمد على سُمك القرنية، القياس، ونمط حياتك — مش الميزانية بس. فحص البنتاكام بيحدد أنهي تقنية آمنة لعينك.</p>
    <div class="price-table-wrap">
    <table class="price-table">
      <thead><tr><th>التقنية</th><th>السعر (جنيه، العينين)</th><th>الأنسب لـ</th></tr></thead>
      <tbody>
        {% for id, treatment in pricing.treatments %}
        <tr{% if treatment.highlight %} class="highlight-row"{% endif %}><td>{{ treatment.ar.name }}{% if id == 'smile-pro' %} ({{ treatment.ar.sub }}){% endif %}</td><td style="direction:ltr;text-align:right">{{ treatment.price_min | formatNumber('ar-EG') }} – {{ treatment.price_max | formatNumber('ar-EG') }}</td><td>{{ treatment.ar.best_for }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
    <p style="font-size:12px;color:var(--muted);margin-top:14px">التقسيط متاح عن طريق ڤاليو وبريميوم كارد. الأسعار في عيادة {{ site.doctor.ar }}، {{ site.address.ar | join('، ') }}.</p>
  </div>
</section>

<!-- FAQ -->
<section class="info-section" style="background:var(--cream)">
  <div class="container">
    <span class="lbl">أسئلة شائعة عن التكلفة</span>
    <div class="rule"></div>
    <h2>قبل ما تقارن أسعار، <em>اقرا ده</em></h2>
    <div class="faq-list">
      {% for faq in calculatorFaqs.ar %}
      <div class="faq-item">
        <button type="button" class="faq-q" onclick="toggleFaq(this)">{{ faq.question }}<span class="faq-icon" aria-hidden="true">+</span></button>
        <div class="faq-a">{{ faq.answer | replace('{doctor}', site.doctor.ar) }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- FOOTER -->
