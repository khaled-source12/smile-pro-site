---
layout: "layouts/landing.njk"
locale: "en"
permalink: "/laser-eye-surgery-cost-egypt/"
canonical: "/laser-eye-surgery-cost-egypt/"
alternate_url: "/ar/laser-eye-surgery-cost-egypt/"
x_default_url: "/laser-eye-surgery-cost-egypt/"
page_kind: "calculator"
page_css: "calculator-en.css"
page_js: "calculator-en.js"
has_form: true
eleventyComputed:
  title: "Laser Eye Surgery Cost in Egypt 2026 — SMILE Pro, LASIK & More | Smile Pro Egypt"
  description: "Find out how much laser eye surgery costs in Egypt. Get a personalised price estimate for SMILE Pro, Femto-LASIK, PRK and ICL based on your prescription."
image: "/images/Naggar6.webp"
show_sticky: true
sitemap: true
---
{% from "partials/forms.njk" import estimator with context %}
{% from "partials/icons.njk" import whatsappIcon %}
<script type="application/json" id="pricing-data">{{ pricing | json | safe }}</script>
<script type="application/json" id="aftercare-data">{{ clinical.aftercare | json | safe }}</script>
<!-- Google Tag Manager (noscript) -->

<!-- End Google Tag Manager (noscript) -->

<!-- NAV -->


<!-- HERO -->
<section class="hero">
  <div class="container">
    <div class="hero-pill">
      <div class="hero-pill-dot"></div>
      Updated September 2026 · real clinic prices
    </div>
    <h1>How much does laser eye<br/>surgery <em>actually cost</em> in Egypt?</h1>
    <p class="hero-sub">Answer a few quick questions about your eyes. Get a personalised price estimate and an initial recommendation for SMILE Pro, Femto-LASIK, PRK, or ICL.</p>
  </div>
</section>

<!-- WIZARD -->
<section class="wizard-section" id="wizard">
  <div class="container">
    <div class="wizard-card">

      <!-- Progress -->
      <div class="wizard-progress">
        <div class="wp-step active" id="wp1"><span class="wp-num">1</span>Your vision</div>
        <div class="wp-step" id="wp2"><span class="wp-num">2</span>Your eyes</div>
        <div class="wp-step" id="wp3"><span class="wp-num">3</span>Your estimate</div>
      </div>

      <div class="wizard-body">

        <!-- ═══ STEP 1: Prescription ═══ -->
        <div class="wiz-step active" id="step1">
          <div class="wiz-q">How strong is your glasses prescription?</div>
          <div class="wiz-hint">Not sure? Pick the one that sounds closest — the Pentacam scan gives us the exact number.</div>
          <div class="opt-grid">
            <button type="button" class="opt-card" aria-pressed="false" onclick="selectOpt(this,'rx','mild')">
              <span class="opt-icon">👓</span>
              <span><span class="opt-label">Mild</span><span class="opt-desc">I can manage without glasses for short periods</span></span>
            </button>
            <button type="button" class="opt-card" aria-pressed="false" onclick="selectOpt(this,'rx','moderate')">
              <span class="opt-icon">🔍</span>
              <span><span class="opt-label">Moderate</span><span class="opt-desc">I need glasses for most activities — faces are blurry across the room</span></span>
            </button>
            <button type="button" class="opt-card" aria-pressed="false" onclick="selectOpt(this,'rx','high')">
              <span class="opt-icon">🌫️</span>
              <span><span class="opt-label">High</span><span class="opt-desc">Everything past arm's length is a blur — I'm helpless without glasses</span></span>
            </button>
            <button type="button" class="opt-card" aria-pressed="false" onclick="selectOpt(this,'rx','extreme')">
              <span class="opt-icon">➖</span>
              <span><span class="opt-label">Very high</span><span class="opt-desc">Around −10.00 D or stronger, or I was told laser may not be suitable</span></span>
            </button>
            <button type="button" class="opt-card" aria-pressed="false" onclick="selectOpt(this,'rx','unsure')">
              <span class="opt-icon">🤷</span>
              <span><span class="opt-label">I'm not sure</span><span class="opt-desc">I know I need correction but don't know how strong</span></span>
            </button>
          </div>
          <div class="wiz-nav">
            <div></div>
            <button type="button" class="wiz-next" id="next1" disabled onclick="goStep(2)">Continue</button>
          </div>
        </div>

        <!-- ═══ STEP 2: Eye conditions & priority ═══ -->
        <div class="wiz-step" id="step2">
          <div class="wiz-q">Anything else about your eyes?</div>
          <div class="wiz-hint">Select all that apply — or skip if none.</div>
          <div class="chk-grid">
            <button type="button" class="chk-card" aria-pressed="false" onclick="toggleChk(this,'thin-cornea')">
              <span class="chk-box"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span><span style="font-weight:500">Thin corneas</span><span style="font-size:12px;color:var(--muted)">Told by a doctor before</span></span>
            </button>
            <button type="button" class="chk-card" aria-pressed="false" onclick="toggleChk(this,'dry-eyes')">
              <span class="chk-box"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span><span style="font-weight:500">Dry or sensitive eyes</span><span style="font-size:12px;color:var(--muted)">Eyes water or sting often</span></span>
            </button>
            <button type="button" class="chk-card" aria-pressed="false" onclick="toggleChk(this,'active')">
              <span class="chk-box"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span><span style="font-weight:500">Active lifestyle / sports</span><span style="font-size:12px;color:var(--muted)">Gym, football, swimming, etc.</span></span>
            </button>
            <button type="button" class="chk-card" aria-pressed="false" onclick="toggleChk(this,'keratoconus')">
              <span class="chk-box"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
              <span><span style="font-weight:500">Keratoconus / eye rubbing</span><span style="font-size:12px;color:var(--muted)">Diagnosed or suspected</span></span>
            </button>
          </div>

          <div style="margin-top:24px">
            <div class="wiz-q" style="font-size:22px">What matters most to you?</div>
            <div class="wiz-hint" id="priority-hint">Pick one priority to continue.</div>
            <div class="opt-grid">
              <button type="button" class="opt-card" data-priority-option aria-pressed="false" onclick="selectOpt(this,'priority','no-dryeye')" style="padding:13px 18px">
                <span class="opt-icon" style="width:32px;height:32px;font-size:15px">💧</span>
                <span><span class="opt-label" style="font-size:14px">Minimise dry eye risk</span></span>
              </button>
              <button type="button" class="opt-card" data-priority-option aria-pressed="false" onclick="selectOpt(this,'priority','fast-recovery')" style="padding:13px 18px">
                <span class="opt-icon" style="width:32px;height:32px;font-size:15px">⚡</span>
                <span><span class="opt-label" style="font-size:14px">Fastest recovery</span></span>
              </button>
              <button type="button" class="opt-card" data-priority-option aria-pressed="false" onclick="selectOpt(this,'priority','lowest-cost')" style="padding:13px 18px">
                <span class="opt-icon" style="width:32px;height:32px;font-size:15px">💰</span>
                <span><span class="opt-label" style="font-size:14px">Lowest cost</span></span>
              </button>
            </div>
          </div>

          <div class="wiz-nav">
            <button type="button" class="wiz-back" onclick="goStep(1)">← Back</button>
            <button type="button" class="wiz-next" id="next2" aria-describedby="priority-hint" disabled onclick="goStep(3)">See my estimate</button>
          </div>
        </div>

        <!-- ═══ STEP 3: Result + Lead Gate ═══ -->
        <div class="wiz-step" id="step3">
          <div class="result-wrap" id="result-area">
            <!-- Populated by JS -->
          </div>

          <!-- Lead gate form -->
          <div class="gate" id="lead-gate">
            <div class="gate-title">Get your full breakdown</div>
            <div class="gate-sub">We'll send your personalised estimate on WhatsApp and book your Pentacam assessment.</div>
            {{ estimator('en') }}
            <p class="form-note">Questions before you visit? Our team can answer them by phone at no charge.</p>
            <div class="wa-alt">
              <span>Prefer to chat first?</span>
              <a href="#" id="wa-results-link" class="wa-link" target="_blank" rel="noopener">
                {{ whatsappIcon() }}
                WhatsApp my results
              </a>
            </div>
          </div>
          <div class="result-details" id="result-details"></div>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- PRICE REFERENCE TABLE -->
<section class="info-section" style="background:var(--white)">
  <div class="container">
    <span class="lbl">Laser eye surgery prices in Egypt — 2026</span>
    <div class="rule"></div>
    <h2>Every option, <em>transparently priced</em></h2>
    <p style="font-size:15px;color:var(--muted);max-width:560px;margin-top:10px;line-height:1.8">Prices are for both eyes and include standard follow-up. The right technology depends on your corneal thickness, prescription, and lifestyle — not just budget. A Pentacam scan tells you which one is safe for your eyes.</p>
    <div class="price-table-wrap">
    <table class="price-table">
      <thead><tr><th>Technology</th><th>Price (EGP, both eyes)</th><th>Best for</th></tr></thead>
      <tbody>
        {% for id, treatment in pricing.treatments %}
        <tr{% if treatment.highlight %} class="highlight-row"{% endif %}><td>{{ treatment.en.name }}{% if id == 'smile-pro' %} ({{ treatment.en.sub }}){% endif %}</td><td>{{ treatment.price_min | formatNumber('en-EG') }} – {{ treatment.price_max | formatNumber('en-EG') }}</td><td>{{ treatment.en.best_for }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
    <p style="font-size:12px;color:var(--muted);margin-top:14px">Instalment plans available through ValU and Premium Card. Prices at {{ site.doctor.en }} Eye Clinic, {{ site.address.en | join(', ') }}.</p>
  </div>
</section>

<!-- FAQ -->
<section class="info-section" style="background:var(--cream)">
  <div class="container">
    <span class="lbl">Common questions about cost</span>
    <div class="rule"></div>
    <h2>Before you compare prices, <em>read this</em></h2>
    <div class="faq-list">
      {% for faq in calculatorFaqs.en %}
      <div class="faq-item">
        <button type="button" class="faq-q" onclick="toggleFaq(this)">{{ faq.question }}<span class="faq-icon" aria-hidden="true">+</span></button>
        <div class="faq-a">{{ faq.answer | replace('{doctor}', site.doctor.en) }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- FOOTER -->
