---
layout: "layouts/landing.njk"
locale: "en"
permalink: "/"
canonical: "/"
alternate_url: "/ar/"
x_default_url: "/"
page_kind: "home"
page_css: "home-en.css"
has_form: true
eleventyComputed:
  title: "SMILE Pro Laser Eye Surgery, {{ site.location.locality.en }} | {{ site.doctor.en }}"
  description: "SMILE Pro flapless laser vision correction with {{ site.doctor.en }} at {{ site.address.en[0] }}, {{ site.location.locality.en }}. ZEISS VisuMax 800. 15-minute procedure, no corneal flap. Book a vision assessment."
image: "/images/Naggar6.webp"
schema_type: "clinic"
show_sticky: true
sitemap: true
---
{% from "partials/forms.njk" import consultation with context %}
{% from "partials/icons.njk" import whatsappIcon %}
{% from "partials/doctor-profile.njk" import doctorTrust, doctorCredentials with context %}
<!-- HERO SECTION -->
<header class="hero">
  <div class="container hero-grid">
    <div>
      <div class="hero-pill">
        <span class="hero-pill-dot"></span>
        ZEISS VisuMax 800 Technology
      </div>
      <h1>Clear Vision in <em>8 Seconds</em> Per Eye</h1>
      <p class="hero-sub">
        Experience SMILE Pro flapless laser vision correction at {{ site.address.en[0] }}, {{ site.location.locality.en }}.
        Advanced German laser precision with minimal disruption and rapid recovery.
      </p>
      <div class="hero-proof">
        <div class="hero-proof-item">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
          No Corneal Flap
        </div>
        <div class="hero-proof-item">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
          Micro-Incision &lt; 2mm
        </div>
        <div class="hero-proof-item">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
          Resume Driving Same Day
        </div>
      </div>
      {{ doctorTrust(locale) }}
    </div>

    <!-- HERO FORM CARD -->
    <div class="form-card" id="book">
      <h2 class="form-card-title">Book Vision Assessment</h2>
      <p class="form-card-sub">Reserve your evaluation at {{ site.address.en[0] }}, {{ site.location.locality.en }}</p>

      {{ consultation('en', 'consultation', 'main-form', 'main', '', 'home-hero') }}

      <a href="tel:{{ site.contact.phone_e164 }}" class="form-call-btn">
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.72A2 2 0 012 .18h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        Call <span class="phone-ltr" dir="ltr">{{ site.contact.phone_e164 | phoneDisplay('en') }}</span>
      </a>

      <div class="form-wa">
        <span>Prefer instant messaging?</span>
        <a href="https://wa.me/{{ site.contact.phone_e164 | whatsappDigits }}" target="_blank" class="wa-link" rel="noopener">
          {{ whatsappIcon() }}
          Chat on WhatsApp
        </a>
      </div>
    </div>
  </div>

  <!-- TRUST BAR -->
  <div class="trust-bar">
    <div class="container trust-inner">
      <div class="trust-item">
        <div class="trust-num">8 Sec</div>
        <div class="trust-lbl">Laser Time Per Eye</div>
      </div>
      <div class="trust-item">
        <div class="trust-num">&lt; 2mm</div>
        <div class="trust-lbl">Micro-Incision</div>
      </div>
      <div class="trust-item">
        <div class="trust-num">100%</div>
        <div class="trust-lbl">Flapless Procedure</div>
      </div>
      <div class="trust-item">
        <div class="trust-num">12 Mos</div>
        <div class="trust-lbl">Follow-Up Included</div>
      </div>
    </div>
  </div>
</header>

{% include "partials/testimonials.njk" %}

<!-- BENEFITS SECTION -->
<section class="section" id="benefits">
  <div class="container">
    <span class="lbl">Why SMILE Pro</span>
    <div class="rule"></div>
    <h2>Engineered for Precision and Comfort</h2>
    <p style="color:var(--muted);max-width:700px;margin-bottom:32px;">
      SMILE Pro utilizes the ZEISS VisuMax 800 to reshape corneal tissue internally without creating a standard flap. This design prioritizes structural integrity and rapid recovery.
    </p>

    <div class="benefits-grid fade-up">
      <div class="b-card">
        <div class="b-icon">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3>No Flap Creation</h3>
        <p>By avoiding a traditional corneal flap, SMILE Pro maintains maximum corneal stability and reduces post-operative sensitivity.</p>
        <span class="b-tag">Preserved Structure</span>
      </div>

      <div class="b-card">
        <div class="b-icon">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <h3>8-Second Laser Delivery</h3>
        <p>The ZEISS VisuMax 800 delivers precise laser pulses in under 10 seconds per eye, ensuring a quick and smooth process.</p>
        <span class="b-tag">Fast Experience</span>
      </div>

      <div class="b-card">
        <div class="b-icon">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <h3>Rapid Daily Return</h3>
        <p>Most patients resume reading, digital screen work, and normal non-contact routines within 24 hours of treatment.</p>
        <span class="b-tag">Minimal Downtime</span>
      </div>
    </div>
  </div>
</section>

<!-- JOURNEY TIMELINE -->
<section class="section" id="journey" style="background:var(--cream2);">
  <div class="container">
    <span class="lbl">Step-by-Step Experience</span>
    <div class="rule"></div>
    <h2>Your Treatment Journey</h2>

    <div class="timeline fade-up">
      <div class="tl-item">
        <div class="tl-dot-wrap">
          <div class="tl-dot">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </div>
          <span class="tl-dot-num">01</span>
        </div>
        <div class="tl-body">
          <div class="tl-time">Step 1 — Comprehensive Scan</div>
          <h3 class="tl-title">Corneal & Vision Mapping</h3>
          <p class="tl-desc">Detailed diagnostic imaging checks corneal thickness, curvature, and prescription accuracy to confirm complete candidate suitability.</p>
          <div class="tl-highlight">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Personalized Treatment Plan
          </div>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-dot-wrap">
          <div class="tl-dot">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
          </div>
          <span class="tl-dot-num">02</span>
        </div>
        <div class="tl-body">
          <div class="tl-time">Step 2 — Procedure Day</div>
          <h3 class="tl-title">15-Minute Micro-Incision Laser</h3>
          <p class="tl-desc">Numbing eye drops are applied for complete comfort. The ZEISS VisuMax 800 shapes the tissue layer in roughly 8 seconds per eye, followed by removal through a tiny micro-incision.</p>
          <div class="tl-highlight">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            No Stitches or Flaps
          </div>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-dot-wrap">
          <div class="tl-dot">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <span class="tl-dot-num">03</span>
        </div>
        <div class="tl-body">
          <div class="tl-time">Step 3 — Recovery & Aftercare</div>
          <h3 class="tl-title">Next-Day Clarity & 12 Months Support</h3>
          <p class="tl-desc">Vision stabilizes rapidly over the first 24 hours. Full post-procedure follow-up visits and prescription drops are included for an entire year.</p>
          <div class="tl-highlight">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            1 Year Follow-Up Care
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- COMPARISON SECTION -->
<section class="section" id="comparison" aria-labelledby="comparison-title">
  <div class="container">
    <span class="lbl">Technology Comparison</span>
    <div class="rule"></div>
    <h2 id="comparison-title">How SMILE Pro Compares</h2>
    <p style="color:var(--muted);max-width:700px;margin-bottom:24px;">
      Selecting a laser eye procedure depends on individual eye anatomy and personal routine. Below is a feature comparison across primary vision correction methods.
    </p>

    {% include "partials/landing-comparison.njk" %}
  </div>
</section>

<!-- CALCULATOR SECTION -->
<section class="section" id="calculator" style="background:var(--cream2);">
  <div class="container">
    <div style="text-align:center;">
      <span class="lbl">Investment & Savings</span>
      <div class="rule" style="margin:0 auto 22px;"></div>
      <h2>Vision Care Cost Comparison</h2>
      <p style="color:var(--muted);max-width:600px;margin:0 auto 24px;">
        Estimate long-term expenditure on contacts and glasses relative to a permanent vision correction treatment.
      </p>
    </div>

    {% set lifetimeExample = (pricing.savings.end_age - pricing.savings.default_age) * pricing.savings.default_annual_spend %}
    {% set savingsExample = lifetimeExample - pricing.savings.reference_price %}
    <div class="calc-wrap fade-up" data-end-age="{{ pricing.savings.end_age }}" data-procedure-cost="{{ pricing.savings.reference_price }}">
      <div class="calc-grid">
        <div class="calc-input-group">
          <label for="calc-age">Current Age</label>
          <input type="number" id="calc-age" value="{{ pricing.savings.default_age }}" min="18" max="{{ pricing.savings.end_age }}" oninput="calculateSavings()" />
        </div>
        <div class="calc-input-group">
          <label for="calc-spend">Annual Contact/Glass Spend (EGP)</label>
          <input type="number" id="calc-spend" value="{{ pricing.savings.default_annual_spend }}" step="500" oninput="calculateSavings()" />
        </div>
      </div>

      <div class="calc-result">
        <div>
          <div class="calc-col-lbl">Lifetime Spend (to Age 60)</div>
          <div class="calc-col-num" id="res-lifetime">{{ lifetimeExample | formatNumber('en-US') }}</div>
          <div class="calc-col-sub">EGP projected expenditure</div>
        </div>
        <div>
          <div class="calc-col-lbl">Estimated Lifetime Savings</div>
          <div class="calc-col-num savings" id="res-savings">{{ savingsExample | formatNumber('en-US') }}</div>
          <div class="calc-col-sub">EGP saved with SMILE Pro</div>
        </div>
      </div>

      <p class="calc-note">
        *Illustrative estimate based on a procedure cost of EGP {{ pricing.savings.reference_price | formatNumber('en-US') }} compared with recurring lens and optical costs up to age {{ pricing.savings.end_age }}. Your final treatment and quote depend on the clinical examination.
      </p>
    </div>
  </div>
</section>

<!-- DOCTOR SECTION -->
<section class="section" id="about-doctor">
  <div class="container">
    <div class="doctor-grid fade-up">
      <div class="doc-img">
        <img src="/images/Naggar6.webp" alt="{{ site.doctor.en }}" width="896" height="1200" eleventy:widths="300,600,896" sizes="(max-width: 398px) calc(100vw - 98px), 300px" loading="lazy" decoding="async" />
        <div class="doc-badge">
          <div class="doc-badge-num">15+</div>
          <div class="doc-badge-lbl">Years Experience</div>
        </div>
      </div>

      <div>
        <span class="lbl">Lead Surgeon</span>
        <div class="rule"></div>
        <h2 class="doc-name">{{ site.doctor.en }}</h2>
        <div class="doc-title">Consultant Corneal & Refractive Surgeon</div>
        <p class="doc-bio">
          {{ site.doctor.en }} specializes in advanced corneal surgery and refractive error corrections.
          Dedicated to utilizing modern diagnostic tools and proven surgical protocols to maintain high safety standards and accurate visual results.
        </p>

        {{ doctorCredentials(locale) }}
      </div>
    </div>
  </div>
</section>

<!-- TECHNOLOGY SECTION -->
<section class="section tech-section" id="technology">
  <div class="container">
    <span class="lbl">Laser Platform</span>
    <div class="rule"></div>
    <h2>ZEISS VisuMax 800 Engineering</h2>

    <div class="tech-grid fade-up">

      <div class="tech-features">
        <div class="tech-feat">
          <div class="tech-feat-icon">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <div>
            <h3 class="tech-feat-title">High Frequency Delivery</h3>
            <div class="tech-feat-desc">Rapid laser pulse emission reduces total tissue exposure time to approximately 8 seconds per eye.</div>
          </div>
        </div>

        <div class="tech-feat">
          <div class="tech-feat-icon">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="12" y1="2" x2="12" y2="22"/></svg>
          </div>
          <div>
            <h3 class="tech-feat-title">Ocular Alignment Guidance</h3>
            <div class="tech-feat-desc">Centration and cyclotorsion correction systems compensate for minor eye position shifts prior to laser execution.</div>
          </div>
        </div>

        <div class="tech-feat">
          <div class="tech-feat-icon">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div>
            <h3 class="tech-feat-title">Gentle Contact Interface</h3>
            <div class="tech-feat-desc">Ergonomically designed curved contact glass minimizes intraocular pressure elevation during treatment.</div>
          </div>
        </div>
            </div>

      <div class="tech-media">
        <video width="360" height="360" poster="/images/device2.webp" loop muted playsinline controls preload="none" data-play-when-visible aria-label="ZEISS VisuMax 800 technology video">
          <source src="/images/Video1.mp4" type="video/mp4"/>
        </video>
      </div>

    </div>
  </div>
</section>

<!-- FAQ SECTION -->
<section class="section" id="faq" style="background:var(--cream2);">
  <div class="container">
    <span class="lbl">Questions & Answers</span>
    <div class="rule"></div>
    <h2>Frequently Asked Questions</h2>

    <div class="faq-list">
      <div class="faq-item">
        <button type="button" class="faq-q" onclick="toggleFaq(this)">
          <span>Will I feel pain during or after SMILE Pro?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-a">
          You usually do not feel pain during SMILE Pro. Numbing eye drops help keep you comfortable throughout the procedure, and you may notice mild pressure on your eye. Afterwards, discomfort is usually mild, and your prescribed eye drops help keep your eyes comfortable as they heal. If you experience severe pain or a sudden decline in vision, contact your doctor immediately.
        </div>
      </div>

      <div class="faq-item">
        <button type="button" class="faq-q" onclick="toggleFaq(this)">
          <span>Are SMILE Pro results permanent, or might I need glasses later?</span>
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-a">
          SMILE Pro results are usually long-lasting, and your vision gradually stabilizes during recovery. If you need reading glasses as you get older, this reflects a natural change in your ability to focus up close and does not, by itself, mean the procedure has lost its effect. If your prescription changes in the future, there are options to address it, such as glasses when needed or an enhancement if suitable for your eyes. Your doctor will explain the options based on your examination and follow-up.
        </div>
      </div>

      <div class="faq-item">
        <button type="button" class="faq-q" onclick="toggleFaq(this)">
          <span>How long does the laser procedure take?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-a">
          The ZEISS VisuMax 800 laser operates for approximately 8 seconds per eye. Total room time, including preparation and alignment, takes around 15 minutes for both eyes.
        </div>
      </div>

      <div class="faq-item">
        <button type="button" class="faq-q" onclick="toggleFaq(this)">
          <span>Who is an eligible candidate for SMILE Pro?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-a">
          Candidates are generally adults aged 18 to 55 with stable prescription over the past year and suitable corneal thickness/topography. Final candidacy is determined through comprehensive diagnostic scanning.
        </div>
      </div>

      <div class="faq-item">
        <button type="button" class="faq-q" onclick="toggleFaq(this)">
          <span>What is included in the SMILE Pro treatment fee?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-a">
          An illustrative EGP {{ pricing.savings.reference_price | formatNumber('en-US') }} treatment quote includes the procedure on both eyes, all surgical consumables, post-op medicated eye drops, and 12 months of follow-up evaluation appointments. The final treatment and fee are confirmed after examination.
        </div>
      </div>

      <div class="faq-item">
        <button type="button" class="faq-q" onclick="toggleFaq(this)">
          <span>When can I resume work and driving?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-a">
          Most patients resume screen reading, general desk work, and driving within 24 hours. For exercise, follow the separate recovery limits: light exercise {{ clinical.aftercare.en.light_exercise }}, gym workouts {{ clinical.aftercare.en.gym }}, swimming {{ clinical.aftercare.en.swimming }}, and contact sports {{ clinical.aftercare.en.contact_sports }}.
        </div>
      </div>
    </div>
  </div>
</section>

<!-- LOCATION SECTION -->
<section class="section" id="location">
  <div class="container">
    <span class="lbl">Clinic Location</span>
    <div class="rule"></div>
    <h2>Visit Us in {{ site.location.locality.en }}</h2>

    <div class="split" style="grid-template-columns:1fr 1fr;margin-top:32px;">
      <div class="card">
        <h3 style="font-size:20px;color:var(--burg);margin-bottom:12px;">{{ site.doctor.en }} Eye Clinic</h3>
        <p style="font-size:14px;color:var(--muted);line-height:1.8;margin-bottom:20px;">
          {% for line in site | clinicAddress('en') %}{{ line }}{% if not loop.last %}<br/>{% endif %}{% endfor %}
        </p>
        <p style="font-size:14px;color:var(--text);font-weight:600;">
          Clinic Hours: {{ site.hours.en }}
        </p>
      </div>

      <div style="width:100%;min-height:260px;border-radius:var(--r);overflow:hidden;border:1px solid var(--border);">
        <iframe
          title="Map showing {{ site.doctor.en }} Eye Clinic in {{ site.address.en[0] }}"
          src="{{ site.location.map_embed_url }}"
          width="100%"
          height="100%"
          style="border:0;min-height:260px;"
          allowfullscreen=""
          loading="lazy">
        </iframe>
      </div>
    </div>
  </div>
</section>

<!-- BOTTOM CTA -->
<section class="cta-section">
  <div class="container">
    <h2>Take the First Step Toward <em>Clear Vision</em></h2>
    <p>Schedule your corneal mapping & vision suitability assessment at {{ site.address.en[0] }}, {{ site.location.locality.en }}.</p>

    <div class="cta-form-wrap fade-up">
      <h3 class="form-card-title">Book Vision Assessment</h3>
      <p class="cta-form-sub">{{ site.address.en | join(' • ') }}</p>

      {{ consultation('en', 'consultation', 'bottom-form', 'cta', '', 'home-bottom') }}
    </div>
  </div>
</section>

<!-- FOOTER -->
