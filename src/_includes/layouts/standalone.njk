<!doctype html>
<html lang="{{ 'ar' if locale == 'ar' else 'en' }}" dir="{{ 'rtl' if locale == 'ar' else 'ltr' }}">
<head>{% include "partials/head.njk" %}</head>
<body class="page-standalone locale-{{ locale }}">
{{ content | safe }}
<script type="module" src="{{ 'js/site.js' | assetUrl }}"></script>
{% if page_js %}<script type="module" src="{{ ('js/pages/' + page_js) | assetUrl }}"></script>{% endif %}
</body>
</html>
