---
layout: layouts/base.njk
---
{% from "partials/forms.njk" import consultation with context %}
{% from "partials/icons.njk" import whatsappIcon %}
<main class="article-page site-shell">
  <header class="article-header">
    <span class="tag">{{ category or ('مقال طبي' if locale == 'ar' else 'Medical article') }}</span>
    <h1 class="article-title">{{ title }}</h1>
    <div class="article-meta">
      <span>{{ site.doctor.ar if locale == 'ar' else site.doctor.en }}</span>
      <span>{{ site.doctor.title_ar if locale == 'ar' else site.doctor.title_en }}</span>
      {% if read_time %}<span>{{ read_time }}</span>{% endif %}
    </div>
  </header>
  {% if image %}
  {% set imageMaxWidth = (560 * image_width / image_height) | round(0, 'ceil') %}
  <img class="main-img" src="{{ image }}" alt="{{ title }}" width="{{ image_width }}" height="{{ image_height }}" eleventy:widths="320,480,640,960,1200" sizes="(max-width: 640px) min(calc(100vw - 28px), {{ imageMaxWidth }}px), min(calc(100vw - 40px), 900px, {{ imageMaxWidth }}px)" loading="eager" decoding="async" fetchpriority="high">
  {% endif %}
  <aside class="article-quick-conversion" aria-label="{{ 'خطوات المتابعة' if locale == 'ar' else 'Next steps' }}">
    <div>
      <strong>{{ 'لا تعرف العملية الأنسب لك؟' if locale == 'ar' else 'Not sure which procedure suits your eyes?' }}</strong>
      <span>{{ 'استخدم الحاسبة للترشيح الأولي أو اطلب من فريق العيادة الاتصال بك.' if locale == 'ar' else 'Use the estimator for an initial recommendation or ask the clinic team to call you.' }}</span>
    </div>
    <div class="conversion-actions">
      <a class="conversion-actions__secondary" href="{{ '/ar/laser-eye-surgery-cost-egypt/' if locale == 'ar' else '/laser-eye-surgery-cost-egypt/' }}" data-cta="article-top-estimator">{{ 'احسب التكلفة' if locale == 'ar' else 'Get an estimate' }}</a>
      <a class="conversion-actions__primary" href="#article-book" data-cta="article-top-book">{{ 'اطلب اتصالاً' if locale == 'ar' else 'Request a call' }}</a>
    </div>
  </aside>
  <article class="article-body">
    {{ content | safe }}
  </article>
  <template id="article-mid-conversion">
    <aside class="article-inline-conversion">
      <strong>{{ 'اعرف العملية الأنسب لعينيك' if locale == 'ar' else 'Find the procedure that fits your eyes' }}</strong>
      <span>{{ 'احصل على ترشيح وسعر مبدئيين، أو اترك رقمك لنتصل بك.' if locale == 'ar' else 'Get an initial recommendation and estimate, or leave your number for a call.' }}</span>
      <div class="conversion-actions">
        <a class="conversion-actions__secondary" href="{{ '/ar/laser-eye-surgery-cost-egypt/' if locale == 'ar' else '/laser-eye-surgery-cost-egypt/' }}" data-cta="article-mid-estimator">{{ 'ابدأ الحاسبة' if locale == 'ar' else 'Start estimator' }}</a>
        <a class="conversion-actions__primary" href="#article-book" data-cta="article-mid-book">{{ 'اطلب اتصالاً' if locale == 'ar' else 'Request a call' }}</a>
      </div>
    </aside>
  </template>
  <section class="article-cta" id="article-book">
    <h2>{{ 'هل تريد معرفة العملية الأنسب لعينيك؟' if locale == 'ar' else 'Which procedure is right for your eyes?' }}</h2>
    <p>{% if locale == 'ar' %}اترك رقمك وسيتصل بك فريق {{ site.doctor.ar }} لترتيب موعد الفحص. المكالمة والإجابة عن أسئلتك قبل الحضور مجاناً بالكامل.{% else %}Leave your number and {{ site.doctor.en }}'s team will call to arrange your assessment. The call and answers to your questions before you visit are completely free.{% endif %}</p>
    <div class="lead-card article-lead-card">
      {{ consultation(locale, 'article-consultation-' + locale, 'article-lead-form', 'article-lead', form_procedure or '', 'article-bottom') }}
      <div class="lead-card__contact">
        <a href="tel:{{ site.contact.phone_e164 }}">{{ 'اتصل الآن' if locale == 'ar' else 'Call now' }} <span class="phone-ltr" dir="ltr">{{ site.contact.phone_e164 | phoneDisplay(locale) }}</span></a>
        <a href="https://wa.me/{{ site.contact.phone_e164 | whatsappDigits }}" target="_blank" rel="noopener">{{ whatsappIcon() }} {{ 'واتساب' if locale == 'ar' else 'WhatsApp' }}</a>
      </div>
    </div>
  </section>
</main>
