<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>document.documentElement.classList.add('js')</script>
<title>{{ seo_title or title }}</title>
<meta name="description" content="{{ seo_description or description }}">
<meta name="robots" content="{{ robots or 'index, follow, max-image-preview:large' }}">
<link rel="canonical" href="{{ site.url }}{{ canonical or page.url }}">
{% if resolved_alternate_url and not (robots and 'noindex' in robots) %}
<link rel="alternate" hreflang="{{ 'ar-EG' if locale == 'en' else 'en-EG' }}" href="{{ site.url }}{{ resolved_alternate_url }}">
<link rel="alternate" hreflang="{{ 'en-EG' if locale == 'en' else 'ar-EG' }}" href="{{ site.url }}{{ canonical or page.url }}">
{% if resolved_x_default_url %}<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ resolved_x_default_url }}">{% endif %}
{% endif %}
<meta property="og:type" content="{{ 'article' if schema_type == 'article' else 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:url" content="{{ site.url }}{{ canonical or page.url }}">
<meta property="og:title" content="{{ seo_title or title }}">
<meta property="og:description" content="{{ seo_description or description }}">
{% if image %}<meta property="og:image" content="{{ image | absoluteUrl(site.url) }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title or title }}">
<meta name="twitter:description" content="{{ seo_description or description }}">
{% if image %}<meta name="twitter:image" content="{{ image | absoluteUrl(site.url) }}">{% endif %}
{% if locale == 'ar' %}
<link rel="preload" href="{{ 'font/cairo-arabic' | assetUrl }}" as="font" type="font/woff2" crossorigin>
{% elif page_kind == 'calculator' or page_kind == 'thank-you' %}
<link rel="preload" href="{{ 'font/cormorant-garamond' | assetUrl }}" as="font" type="font/woff2" crossorigin>
{% else %}
<link rel="preload" href="{{ 'font/dm-sans' | assetUrl }}" as="font" type="font/woff2" crossorigin>
{% endif %}
<link rel="icon" type="image/webp" sizes="32x32" href="{{ 'image/favicon' | assetUrl }}">
<style data-critical-css>{{ page_css | criticalCss(locale, page_kind or 'standard') | safe }}</style>
{% if schema_type == 'article' %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"MedicalWebPage","headline":{{ title | json | safe }},"description":{{ (seo_description or description) | json | safe }},"image":{{ image | absoluteUrl(site.url) | json | safe }},"datePublished":{{ date | dateOnly | json | safe }},"author":{"@type":"Physician","name":{{ site.doctor[locale] | json | safe }}},"publisher":{"@type":"MedicalOrganization","@id":{{ (site.url + '/#clinic') | json | safe }},"name":{{ site.name | json | safe }}}}
</script>
{% elif schema_type == 'clinic' %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":["MedicalClinic","LocalBusiness"],"@id":{{ (site.url + '/#clinic') | json | safe }},"name":{{ site.name | json | safe }},"url":{{ (site.url + '/') | json | safe }},"telephone":{{ site.contact.phone_e164 | json | safe }},"image":{{ (site.url + '/images/Naggar6.webp') | json | safe }},"sameAs":{{ site.social | nonEmptyValues | json | safe }},"address":{"@type":"PostalAddress","streetAddress":{{ site | clinicAddress(locale) | join(', ') | json | safe }},"addressLocality":{{ site.location.locality[locale] | json | safe }},"addressCountry":"EG"}}
</script>
{% endif %}
{% if page_kind == 'calculator' %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for faq in calculatorFaqs[locale] %}{"@type":"Question","name":{{ faq.question | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ faq.answer | replace('{doctor}', site.doctor[locale]) | json | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
{% endif %}
{% if trackingEnabled and tracking != false %}
<link rel="preconnect" href="https://www.googletagmanager.com">
{% include "partials/tracking-head.njk" %}
{% endif %}
