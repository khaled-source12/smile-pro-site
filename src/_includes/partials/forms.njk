{% macro consultation(locale='en', formName='consultation', formId='main-form', fieldPrefix='main', compact=false, defaultProcedure='smile-pro') %}
<form name="{{ formName }}" id="{{ formId }}" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="{{ '/ar/thank-you.html' if locale == 'ar' else '/thank-you.html' }}">
  <input type="hidden" name="form-name" value="{{ formName }}">
  <input type="hidden" name="bot-field">
  <input type="hidden" name="language" value="{{ locale }}">
  <div class="fg">
    <label for="{{ fieldPrefix }}-name">{{ 'الاسم بالكامل' if locale == 'ar' else 'Full Name' }}</label>
    <input type="text" id="{{ fieldPrefix }}-name" name="name" placeholder="{{ 'أدخل اسمك بالكامل' if locale == 'ar' else 'Enter your full name' }}" autocomplete="name" required>
  </div>
  <div class="fg">
    <label for="{{ fieldPrefix }}-phone">{{ 'رقم الهاتف' if locale == 'ar' else 'Phone Number' }}</label>
    <input type="tel" id="{{ fieldPrefix }}-phone" name="phone" placeholder="01X XXXX XXXX" inputmode="tel" autocomplete="tel" required>
  </div>
  {% if not compact %}
  <div class="fg">
    <label for="{{ fieldPrefix }}-procedure">{{ 'التقنية المطلوبة' if locale == 'ar' else ('Selected Procedure' if defaultProcedure == 'femto-lasik' else 'Interested Procedure') }}</label>
    <div class="sel-wrap">
      <select id="{{ fieldPrefix }}-procedure" name="procedure">
        <option value="smile-pro"{% if defaultProcedure == 'smile-pro' %} selected{% endif %}>{{ 'سمايل برو' if locale == 'ar' else 'SMILE Pro' }} (VisuMax 800)</option>
        <option value="custom-lasik">{{ 'الليزك التفصيلي' if locale == 'ar' else 'Custom LASIK' }}</option>
        <option value="femto-lasik"{% if defaultProcedure == 'femto-lasik' %} selected{% endif %}>{{ 'الفيمتو ليزك' if locale == 'ar' else 'Femto LASIK' }}</option>
        <option value="not-sure">{{ 'غير متأكد / أحتاج إلى فحص' if locale == 'ar' else 'Unsure / Need Assessment' }}</option>
      </select>
    </div>
  </div>
  {% endif %}
  <button type="submit" class="form-btn">{% if compact %}{{ 'طلب موعد الفحص' if locale == 'ar' else 'Request Evaluation Slot' }}{% else %}{{ 'تأكيد طلب الفحص' if locale == 'ar' else 'Confirm Assessment Request' }}{% endif %}</button>
</form>
{% endmacro %}

{% macro estimator(locale='en') %}
<form name="{{ 'price-estimator-ar' if locale == 'ar' else 'price-estimator' }}" id="estimator-form" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="{{ '/ar/thank-you.html' if locale == 'ar' else '/thank-you.html' }}" data-managed-form="custom">
  <input type="hidden" name="form-name" value="{{ 'price-estimator-ar' if locale == 'ar' else 'price-estimator' }}">
  <input type="hidden" name="bot-field">
  <input type="hidden" name="language" value="{{ locale }}">
  <input type="hidden" name="service" value="price-estimator">
  <input type="hidden" name="recommended-tech" id="h-tech" value="">
  <input type="hidden" name="prescription" id="h-rx" value="">
  <input type="hidden" name="conditions" id="h-conditions" value="">
  <input type="hidden" name="priority" id="h-priority" value="">
  <input type="hidden" name="price-range" id="h-price" value="">
  <div class="fg">
    <label for="est-name">{{ 'الاسم بالكامل' if locale == 'ar' else 'Full name' }}</label>
    <input type="text" id="est-name" name="name" placeholder="{{ 'أحمد محمد' if locale == 'ar' else 'Ahmed Mohamed' }}" autocomplete="name" required>
  </div>
  <div class="fg">
    <label for="est-phone">{{ 'رقم الواتساب' if locale == 'ar' else 'WhatsApp number' }}</label>
    <input type="tel" id="est-phone" name="phone" placeholder="{{ '01X XXXX XXXX' if locale == 'ar' else '+20 1XX XXX XXXX' }}" inputmode="tel" autocomplete="tel" aria-describedby="phone-error" aria-invalid="false" required{% if locale == 'ar' %} dir="ltr" style="text-align:left"{% endif %}>
    <div class="field-error" id="phone-error" role="alert">{{ 'من فضلك اكتب رقم موبايل مصري صحيح' if locale == 'ar' else 'Please enter a valid Egyptian mobile number' }}</div>
  </div>
  <button type="submit" class="form-btn"{% if locale == 'ar' %} id="est-submit-btn"{% endif %}>{{ 'احجز فحص البنتاكام ←' if locale == 'ar' else 'Book my Pentacam assessment →' }}</button>
</form>
{% endmacro %}
