<footer class="site-footer">
  <div class="site-shell site-footer__grid">
    <a class="site-footer__brand" href="{{ '/ar/' if locale == 'ar' else '/' }}">Smile <span>Pro</span> Egypt</a>
    <div>
      {% for line in site | clinicAddress(locale) %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}<br>
      <a class="phone-ltr" dir="ltr" href="tel:{{ site.contact.phone_e164 }}">{{ site.contact.phone_e164 | phoneDisplay(locale) }}</a>
    </div>
    <div>{{ site.hours[locale] }}<br><a href="{{ '/ar/privacy/' if locale == 'ar' else '/privacy/' }}">{{ 'سياسة الخصوصية' if locale == 'ar' else 'Privacy policy' }}</a><br>© 2026 Smile Pro Egypt</div>
  </div>
</footer>
