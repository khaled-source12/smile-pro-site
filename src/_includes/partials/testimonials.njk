<section class="section testimonials-section" id="reviews">
  <div class="container">
    <span class="lbl">{{ 'تجارب المرضى' if locale == 'ar' else 'Patient Experiences' }}</span>
    <div class="rule"></div>
    <h2>{{ 'نتائج وآراء مرضانا' if locale == 'ar' else 'Real Patient Outcomes' }}</h2>
    <div class="testi-grid fade-up">
      <div class="testi-card">
        <div class="testi-stars">★★★★★</div>
        <div class="testi-quote">{{ '"خطوة الليزر كانت سريعة جداً بشكل لم أتوقعه. عدت لعملي المكتبي وقراءة المستندات في اليوم التالي مباشرة."' if locale == 'ar' else '"The laser phase felt so quick. I was back at my desk and reviewing documents the very next afternoon."' }}</div>
        <div class="testi-author"><div class="testi-avatar">{{ 'أ' if locale == 'ar' else 'A' }}</div><div><div class="testi-name">{{ 'أحمد م.' if locale == 'ar' else 'Ahmed M.' }}</div><div class="testi-detail">{{ 'مهندس برمجيات • سمايل برو' if locale == 'ar' else 'Software Engineer • SMILE Pro' }}</div></div></div>
      </div>
      <div class="testi-card">
        <div class="testi-stars">★★★★★</div>
        <div class="testi-quote">{{ '"قام دكتور محمد النجار بشرح نتائج فحص القرنية بالتفصيل. التعامل والتنظيم في العيادة بالتجمع الخامس ممتاز جداً."' if locale == 'ar' else '"Dr. El Naggar thoroughly explained my corneal scan results. The entire clinic process in New Cairo was smooth."' }}</div>
        <div class="testi-author"><div class="testi-avatar">{{ 'س' if locale == 'ar' else 'S' }}</div><div><div class="testi-name">{{ 'سارة ك.' if locale == 'ar' else 'Sara K.' }}</div><div class="testi-detail">{{ 'مهندسة معمارية • سمايل برو' if locale == 'ar' else 'Architect • SMILE Pro' }}</div></div></div>
      </div>
      <div class="testi-card">
        <div class="testi-stars">★★★★★</div>
        <div class="testi-quote">{{ '"التخلص من جفاف العدسات اللاصقة أثناء التمرين والرياضة اليومية أحدث فرقاً كبيراً في راحتي."' if locale == 'ar' else '"Not having to deal with contact lens dryness during daily workouts has made a noticeable difference."' }}</div>
        <div class="testi-author"><div class="testi-avatar">{{ 'ع' if locale == 'ar' else 'O' }}</div><div><div class="testi-name">{{ 'عمر ت.' if locale == 'ar' else 'Omar T.' }}</div><div class="testi-detail">{{ 'مدرب لياقة بدنية • سمايل برو' if locale == 'ar' else 'Fitness Coach • SMILE Pro' }}</div></div></div>
      </div>
    </div>
  </div>
</section>
