{% from "partials/icons.njk" import whatsappIcon %}
{% if show_sticky %}
<div class="site-sticky-actions{% if page_kind == 'calculator' %} site-sticky-actions--deferred{% endif %}"{% if page_kind == 'calculator' %} id="sticky-bar"{% endif %}>
  <div class="site-sticky-actions__inner">
    <p class="site-sticky-actions__offer" data-package-offer>
      <span class="site-sticky-actions__offer-label">{{ 'باقة SMILE Pro' if locale == 'ar' else 'SMILE Pro Package' }}</span>
      <strong class="site-sticky-actions__price">{% if locale == 'ar' %}{{ pricing.savings.reference_price | formatNumber('ar-EG') }} جنيه مصري{% else %}{{ pricing.savings.reference_price | formatNumber('en-US') }} EGP{% endif %}</strong>
      <span class="site-sticky-actions__offer-details">{{ '(العينان ومتابعة ١٢ شهرًا)' if locale == 'ar' else '(Both Eyes & 12 Mos Care)' }}</span>
    </p>
    <div class="site-sticky-actions__links">
      <a class="site-sticky-actions__whatsapp" href="https://wa.me/{{ site.contact.phone_e164 | whatsappDigits }}" target="_blank" rel="noopener" data-cta="sticky-whatsapp">{{ whatsappIcon() }}<span>{{ 'واتساب' if locale == 'ar' else 'WhatsApp' }}</span></a>
      <a class="site-sticky-actions__book" href="{{ resolved_booking_url }}" data-cta="sticky-book">{% if page_kind == 'calculator' %}{{ 'احسب السعر' if locale == 'ar' else 'Get my estimate' }}{% else %}{{ 'احجز فحص النظر' if locale == 'ar' else 'Book assessment' }}{% endif %}</a>
    </div>
  </div>
</div>
{% endif %}
