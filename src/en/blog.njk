---
layout: layouts/base.njk
locale: en
permalink: /en/blog/
canonical: /en/blog/
alternate_url: /blog/
x_default_url: /en/blog/
page_kind: blog
page_css: blog.css
eleventyComputed:
  title: "Laser Vision Correction Blog | {{ site.doctor.en }} - Smile Pro"
  description: "Practical medical guides to SMILE Pro, Femto LASIK, corneal assessment, and recovery with {{ site.doctor.en }}."
image: /images/Naggar6.webp
show_sticky: true
booking_url: "/#book"
sitemap: true
---
{% set posts = collections.articles | byLocale('en') | sortByDateDesc %}
{% set categories = posts | uniqueDataValues('category') %}
<header class="blog-hero">
  <div class="container">
    <span class="doc-badge">Medical content reviewed by {{ site.doctor.en }}</span>
    <h1>Vision correction and corneal health</h1>
    <p>Clear, practical guides to procedures, assessments, and recovery before you decide on vision correction.</p>
  </div>
</header>
<main class="container blog-main">
  <section class="blog-conversion-panel">
    <div><strong>Want a recommendation before you keep reading?</strong><span>Estimate your options now, or request a call from the clinic team.</span></div>
    <div class="conversion-actions">
      <a class="conversion-actions__secondary" href="/laser-eye-surgery-cost-egypt/" data-cta="blog-top-estimator">Get an estimate</a>
      <a class="conversion-actions__primary" href="/#book" data-cta="blog-top-book">Request a call</a>
    </div>
  </section>
  <div class="category-bar" role="group" aria-label="Filter articles">
    <button class="cat-tab active" type="button" data-blog-filter="all" aria-pressed="true">All</button>
    {% for category in categories %}<button class="cat-tab" type="button" data-blog-filter="{{ category }}" aria-pressed="false">{{ category }}</button>{% endfor %}
  </div>
  <div class="blog-grid">
    {% for post in posts %}
    <article class="post-card" data-blog-category="{{ post.data.category }}">
      <img src="{{ post.data.image }}" alt="{{ post.data.title }}" class="post-img" width="{{ post.data.image_width }}" height="{{ post.data.image_height }}" eleventy:widths="320,480,640,960" sizes="(min-width: 1120px) 336px, (min-width: 1068px) calc((100vw - 114px) / 3), (min-width: 718px) calc((100vw - 82px) / 2), calc(100vw - 50px)" loading="{{ 'eager' if loop.first else 'lazy' }}"{% if loop.first %} fetchpriority="high"{% endif %} decoding="async">
      <div class="post-body">
        <span class="tag">{{ post.data.category }}</span>
        <h2 class="post-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p class="post-desc">{{ post.data.excerpt }}</p>
        <div class="meta-info"><span>{{ post.data.read_time }}</span><a href="{{ post.url }}" class="read-btn">Read article →</a></div>
      </div>
    </article>
    {% endfor %}
  </div>
  <section class="cta-banner">
    <h2>Which procedure is right for your eyes?</h2>
    <p>Book a comprehensive corneal assessment with {{ site.doctor.en }} in {{ site.location.locality.en }}.</p>
    <div class="conversion-actions"><a href="/#book" class="cta-btn" data-cta="blog-bottom-book">Book your assessment</a><a href="/laser-eye-surgery-cost-egypt/" class="cta-btn cta-btn--outline" data-cta="blog-bottom-estimator">Get an estimate</a></div>
  </section>
</main>
