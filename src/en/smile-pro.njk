---
layout: "layouts/landing.njk"
locale: "en"
permalink: "/en/smile-pro/"
canonical: "/en/smile-pro/"
alternate_url: "/smile-pro/"
x_default_url: "/en/smile-pro/"
page_kind: "smile-pro"
page_css: "smile-pro.css"
has_form: true
eleventyComputed:
  title: "SMILE Pro Technology in Egypt | {{ site.doctor.en }}"
  description: "Discover flapless SMILE Pro vision correction with ZEISS VisuMax 800 and {{ site.doctor.en }} in {{ site.location.locality.en }}."
image: "/images/Naggar6.webp"
show_sticky: true
sitemap: true
---
{% from "partials/forms.njk" import consultation with context %}
{% from "partials/icons.njk" import whatsappIcon %}
{% from "partials/doctor-profile.njk" import doctorTrust with context %}
<!-- Hero Section -->
    <header class="hero">
        <div class="container hero-grid">
            <div>
                <span class="hero-badge">The latest generation of vision correction in 2026</span>
                <h1 id="heroH1">SMILE Pro Technology<br>Vision Correction in Just 8 Seconds</h1>
                <p id="heroP">Restore your sharp vision flapless and pain-free using the advanced ZEISS VisuMax 800.</p>

                <div class="hero-stats">
                    <div class="stat-item">
                        <h3>8 seconds</h3>
                        <p id="stat1">Laser Treatment Time</p>
                    </div>
                    <div class="stat-item">
                        <h3>2 mm</h3>
                        <p id="stat2">Micro Incision</p>
                    </div>
                    <div class="stat-item">
                        <h3>100%</h3>
                        <p id="stat3">Flapless Procedure</p>
                    </div>
                </div>
                {{ doctorTrust(locale, 'dark') }}

                <a href="#book" class="cta-btn" id="heroCta" data-cta="smile-hero-book">Book Your Vision Assessment</a>
            </div>
            <div class="lead-card" id="book">
                <h2>Book Your Vision Assessment</h2>
                <p class="lead-card__sub">Leave your details and our team will call to arrange your assessment and answer your questions.</p>
                {{ consultation('en', 'smile-pro-hero-en', 'smile-pro-hero-form-en', 'smile-hero-en', 'smile-pro', 'smile-pro-hero') }}
                <div class="lead-card__contact">
                    <a href="tel:{{ site.contact.phone_e164 }}">Call <span class="phone-ltr" dir="ltr">{{ site.contact.phone_e164 | phoneDisplay('en') }}</span></a>
                    <a href="https://wa.me/{{ site.contact.phone_e164 | whatsappDigits }}" target="_blank" rel="noopener">{{ whatsappIcon() }} WhatsApp</a>
                </div>
            </div>
        </div>
    </header>

    <main class="container">
        <!-- Key Features -->
        <section>
            <div class="sec-title">
                <h2 id="featTitle">Why Choose SMILE Pro?</h2>
                <p id="featSub">Combining ultimate safety, speed, and comfort for every patient.</p>
            </div>
            <div class="features-grid">
                <div class="feat-card">
                    <span class="feat-icon">⚡</span>
                    <h3 id="f1T">Ultra Fast (8 Seconds)</h3>
                    <p id="f1D">Reduces laser delivery time to 1/3 compared to traditional SMILE for total patient comfort.</p>
                </div>
                <div class="feat-card">
                    <span class="feat-icon">🛡️</span>
                    <h3 id="f2T">Corneal Biomechanical Safety</h3>
                    <p id="f2D">Flapless procedure that preserves long-term structural integrity of your cornea.</p>
                </div>
                <div class="feat-card">
                    <span class="feat-icon">💧</span>
                    <h3 id="f3T">Minimal Dry Eyes</h3>
                    <p id="f3D">Preserves over 80% of corneal nerves, significantly reducing post-op dry eye risk.</p>
                </div>
                <div class="feat-card">
                    <span class="feat-icon">🎯</span>
                    <h3 id="f4T">Precise Astigmatism Correction</h3>
                    <p id="f4D">Smart OcuLign & CentraLign axis alignment for superior visual clarity.</p>
                </div>
            </div>
        </section>

        <!-- Technology Overview -->
        <section>
            <div class="tech-box">
                <img src="/images/device2.webp" alt="ZEISS VisuMax 800 laser system" width="690" height="690" eleventy:widths="240,320,480,640,690" sizes="(max-width: 510px) calc(100vw - 90px), (max-width: 768px) 420px, (max-width: 1100px) calc((100vw - 152px) / 2), 474px" loading="lazy" decoding="async">
                <div class="tech-info">
                    <h3 id="techH3">Powered by ZEISS VisuMax 800</h3>
                    <p id="techP" style="color:var(--muted); margin-bottom:20px;">The latest generation femtosecond laser system engineered by Carl Zeiss Germany for maximum surgical precision.</p>
                    <ul id="techList"><li>2 MHz laser pulse frequency for rapid lenticule creation.</li>
                    <li>AI-assisted eye tracking and automatic axis alignment.</li>
                    <li>Virtually zero pressure sensation during the procedure.</li>
                    <li>Rapid visual recovery allowing immediate return to daily activities.</li></ul>
                </div>
            </div>
        </section>

        <!-- Step by Step Workflow -->
        <section>
            <div class="sec-title">
                <h2 id="stepTitle">Surgical Workflow with {{ site.doctor.en }}</h2>
                <p id="stepSub">A seamless 15-minute procedure designed for maximum comfort.</p>
            </div>
            <div class="steps-wrapper">
                <div class="step-card">
                    <div class="step-num">Step 01</div>
                    <h3 id="s1T">Topical Anesthesia</h3>
                    <p id="s1D">Numbing eye drops applied with zero needles or pain.</p>
                </div>
                <div class="step-card">
                    <div class="step-num">Step 02</div>
                    <h3 id="s2T">8-Second Laser Step</h3>
                    <p id="s2D">VisuMax 800 creates the precise lenticule in under 8 seconds.</p>
                </div>
                <div class="step-card">
                    <div class="step-num">Step 03</div>
                    <h3 id="s3T">Lenticule Extraction</h3>
                    <p id="s3D">The surgeon delicately removes the lenticule through a 2mm keyhole incision.</p>
                </div>
                <div class="step-card">
                    <div class="step-num">Step 04</div>
                    <h3 id="s4T">Natural Healing</h3>
                    <p id="s4D">Self-sealing incision requiring no stitches; clear vision resumes within hours.</p>
                </div>
            </div>
        </section>

        <!-- Comparison Table -->
        <section id="comparison" aria-labelledby="compTitle">
            <div class="sec-title">
                <h2 id="compTitle">SMILE Pro vs. Other Laser Procedures</h2>
                <p>Compare the key differences. Your eye examination determines which procedure is suitable for you.</p>
            </div>
            {% include "partials/landing-comparison.njk" %}
        </section>

        <!-- Booking CTA Section -->
        <section id="book-again">
            <div class="cta-box">
                <h2 id="ctaH2">Ready to Live Free from Glasses & Contact Lenses?</h2>
                <p id="ctaP">Book your comprehensive corneal evaluation with {{ site.doctor.en }} to determine whether SMILE Pro is suitable for your eyes.</p>
                <div class="lead-card lead-card--bottom">
                    {{ consultation('en', 'smile-pro-bottom-en', 'smile-pro-bottom-form-en', 'smile-bottom-en', 'smile-pro', 'smile-pro-bottom') }}
                    <div class="lead-card__contact"><a href="https://wa.me/{{ site.contact.phone_e164 | whatsappDigits }}" target="_blank" rel="noopener">{{ whatsappIcon() }} Chat on WhatsApp</a></div>
                </div>
            </div>
        </section>
    </main>
