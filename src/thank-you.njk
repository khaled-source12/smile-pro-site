{% from "partials/icons.njk" import whatsappIcon %}
<!-- Google Tag Manager (noscript) -->

<!-- End Google Tag Manager (noscript) -->



<main>
  <div class="card">

    <div class="check-circle">
      <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
    </div>

    <h1>You're all set!</h1>

    <p class="message">
      Thank you, we have received your request for a <strong>vision assessment.</strong><br/><br/>
      During clinic hours, our team will call you within <strong>15 minutes</strong> to confirm your appointment at {{ site | clinicAddress('en') | join(', ') }} and answer your questions at no charge.
    </p>

    <div class="steps">
      <div class="step-row">
        <div class="step-dot">1</div>
        <div class="step-text">
          Our team calls you within 15 minutes during clinic hours
          <span>We'll answer your questions at no charge and confirm a convenient assessment time</span>
        </div>
      </div>
      <div class="step-row">
        <div class="step-dot">2</div>
        <div class="step-text">
          Comprehensive Pentacam assessment at {{ site.address.en[0] }}
          <span>A detailed eye examination and corneal scan, around 30 minutes</span>
        </div>
      </div>
      <div class="step-row">
        <div class="step-dot">3</div>
        <div class="step-text">
          Your personalised vision-correction plan
          <span>Your clinician will explain the procedure, recovery timeline, and when it is safe to drive. Please arrange transport home on the day of treatment.</span>
        </div>
      </div>
    </div>

    <a href="https://wa.me/{{ site.contact.phone_e164 | whatsappDigits }}?text=Hello, I've just submitted my request and would like to confirm my appointment" class="wa-btn" target="_blank" rel="noopener">
      {{ whatsappIcon() }}
      Chat with us on WhatsApp now
    </a>

    <span class="back-link"><a href="/">Return to the homepage</a></span>

  </div>
</main>



